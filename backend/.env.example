# ---------------------------------------------------------------------------
# Incident Management Portal - backend configuration
# Copy this file to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (local instance or an Atlas free-tier cluster)
MONGO_URI=mongodb://127.0.0.1:27017/incident_management

# Sign/verify secret for JWTs. Use a long random value - in production the
# server refuses to start with a secret shorter than 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_before_deploying
JWT_EXPIRES_IN=7d

# --- OAuth 2.0 (FR5-02) ----------------------------------------------------
# Access tokens for the public REST API (/api/v1/oauth/token -> /api/v1/tickets)
# are signed with a separate secret so they can never be swapped with portal
# JWTs. In production this MUST be its own long random value (>= 32 chars) that
# differs from JWT_SECRET; in development it falls back to JWT_SECRET.
OAUTH_ACCESS_TOKEN_SECRET=
OAUTH_ACCESS_TOKEN_EXPIRES_IN=3600
OAUTH_TOKEN_ISSUER=incident-portal-api
OAUTH_TOKEN_AUDIENCE=incident-portal-api

# Allowed browser origins for CORS (comma-separated).
CLIENT_URL=http://localhost:5173

# --- File uploads (FR-08) -------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain

# --- Email notifications (FR-09) ------------------------------------------
# Left disabled by default: the portal works fully without SMTP and still
# records in-app notifications. For Gmail, use smtp.gmail.com, port 465,
# SMTP_SECURE=true, your Gmail address and a 16-character Google app password.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Incident Portal <no-reply@incident.local>

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=30

# --- FR5-09: Public API daily credits (per OAuth client) ------------------
# Each OAuth client is limited to this many API requests per UTC day.
# When the limit is exceeded, the API returns HTTP 429 with a Retry-After header.
PUBLIC_API_DAILY_CREDITS=2

# --- Misc -----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# When true, `npm run seed` wipes the collections before inserting demo data.
SEED_RESET=true

# --- CSAT / Survey (FR4-26..29) --------------------------------------------
# Ratings below this value flag the incident for manager follow-up. Default: 3
# (ratings 1 and 2 are flagged; 3, 4, 5 are not).
CSAT_FOLLOWUP_THRESHOLD=3

# --- FR4-16 Email Intake (IMAP polling) ------------------------------------
# Leave INTAKE_IMAP_HOST unset (or empty) to disable email intake entirely.
# The cron job will still be registered but will skip each poll cycle.
INTAKE_IMAP_HOST=imap.gmail.com
INTAKE_IMAP_PORT=993
INTAKE_IMAP_USER=rajappanrajappan982@gmail.com
INTAKE_IMAP_PASSWORD=ppzxmxmjguqstnxk
# Comma-separated sender whitelist. Empty = allow all senders.
INTAKE_SENDER_ALLOWLIST=
# Gmail X-GM-RAW "after:" cutoff in YYYY/MM/DD format.
INTAKE_SINCE_DATE=2026/09/02
# Gmail label applied after successful processing.
INTAKE_LABEL=INC
# node-cron schedule for mailbox polling (default: every minute).
INTAKE_POLL_CRON=* * * * *

# --- Required by BOTH intake paths (email + webhook) ---
# User _id used as Incident.reportedBy when the sender email does not match
# any registered User. Create with:  db.users.findOne({ role: "admin" })
INTAKE_SYSTEM_USER_ID=
# Category _id used as Incident.category for auto-created incidents.
# Create with:  db.categories.findOne()
INTAKE_DEFAULT_CATEGORY_ID=
