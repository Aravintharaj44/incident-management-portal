# ---------------------------------------------------------------------------
# Incident Management Portal - frontend configuration
# Copy to `.env` (or `.env.local`) if you need to change the defaults.
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Where the backend API lives. Leave unset to use http://localhost:5000/api/v1.
# Set to /api/v1 to route through the Vite dev proxy instead.
VITE_API_URL=http://localhost:5000/api/v1

# ---------------------------------------------------------------------------
